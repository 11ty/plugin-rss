{
  "name": "@11ty/eleventy-plugin-rss",
  "version": "4.0.0",
  "type": "module",
  "description": "Generate an Atom, RSS, or JSON feed.",
  "publishConfig": {
    "access": "public"
  },
  "main": ".eleventy.js",
  "scripts": {
    "test": "npx ava",
    "sample": "cd sample && npx @11ty/eleventy --config=config-sample.js --pathprefix=pathprefix",
    "clean": "rm -rf sample/_site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/11ty/plugin-rss.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/11ty"
  },
  "keywords": [
    "eleventy",
    "eleventy-plugin"
  ],
  "author": {
    "name": "Zach Leatherman",
    "email": "zachleatherman@gmail.com",
    "url": "https://zachleat.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bugs": {
    "url": "https://github.com/11ty/plugin-rss/issues"
  },
  "homepage": "https://www.11ty.dev/docs/plugins/rss/",
  "11ty": {
    "compatibility": ">=3.0.0-alpha.15"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ava": "^6.4.1"
  },
  "dependencies": {
    "@11ty/eleventy-utils": "^3.0.1",
    "@11ty/posthtml-urls": "^2.0.0",
    "obug": "^3.0.0",
    "posthtml": "^0.16.7"
  }
}
